{
  "name": "loadshape",
  "version": "0.0.0",
  "description": "Состояния загрузки для React: скелетон из самого компонента, спиннер и полоса перехода",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./tanstack-router": {
      "source": "./src/tanstack-router.tsx",
      "types": "./dist/tanstack-router.d.ts",
      "default": "./dist/tanstack-router.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.41",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tsdown/css": "^0.23.0",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "react": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./tanstack-router": {
        "types": "./dist/tanstack-router.d.ts",
        "default": "./dist/tanstack-router.js"
      },
      "./package.json": "./package.json"
    }
  }
}
