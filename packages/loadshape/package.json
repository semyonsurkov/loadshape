{
  "name": "loadshape",
  "version": "0.2.4",
  "description": "Loading states for React 18 and 19: skeletons from your components, inline spinners, and route progress",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./tanstack-router": {
      "source": "./src/tanstack-router.tsx",
      "types": "./dist/tanstack-router.d.ts",
      "default": "./dist/tanstack-router.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project ssr",
    "test:browser": "vitest run --project browser",
    "test:all": "pnpm test && pnpm test:browser",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.41",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@tsdown/css": "^0.23.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.6",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.6"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./tanstack-router": {
        "types": "./dist/tanstack-router.d.ts",
        "default": "./dist/tanstack-router.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semyonsurkov/loadshape.git",
    "directory": "packages/loadshape"
  },
  "homepage": "https://github.com/semyonsurkov/loadshape#readme",
  "bugs": {
    "url": "https://github.com/semyonsurkov/loadshape/issues"
  }
}
