{
  "name": "loadshape-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter loadshape test",
    "test:browser": "pnpm --filter loadshape test:browser",
    "test:all": "pnpm --filter loadshape test:all",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9"
  }
}
